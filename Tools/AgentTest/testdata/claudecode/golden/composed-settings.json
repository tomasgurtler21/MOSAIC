{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "/abs/path/to/interceptor",
            "args": [
              "intercept",
              "--phase",
              "pre"
            ],
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "hook.py"
            ],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "hook.py"
            ],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
