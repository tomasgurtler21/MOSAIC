{
  "schema_version": 1,
  "test_id": "blocked-e101-retry",
  "on_unmatched": "halt",
  "stubs": [
    {
      "match": { "tool": "dispatch", "agent": "implementation-tdd", "invocation": 1 },
      "response": {
        "agent_instance_id": "implementation-tdd#10",
        "run_id": "{run_id}",
        "status_code": "BLOCKED",
        "status_message": "Cannot proceed. Required input artifact Stage-1/Plan.md does not exist.",
        "error_code": "E101",
        "error_reason": "INPUT_NOT_FOUND: Orchestration-{run_id}/Stage-1/Plan.md not found"
      }
    },
    {
      "match": { "tool": "dispatch", "agent": "implementation-tdd", "invocation": 2 },
      "response": {
        "agent_instance_id": "implementation-tdd#11",
        "run_id": "{run_id}",
        "status_code": "SUCCESS",
        "status_message": "Implemented verbose flag parsing and wired to diagnostics."
      }
    }
  ]
}
