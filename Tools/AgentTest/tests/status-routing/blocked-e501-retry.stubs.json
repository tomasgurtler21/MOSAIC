{
  "schema_version": 1,
  "test_id": "blocked-e501-retry",
  "on_unmatched": "halt",
  "stubs": [
    {
      "match": { "tool": "dispatch", "agent": "implementation-tdd", "invocation": 1 },
      "response": {
        "agent_instance_id": "implementation-tdd#10",
        "run_id": "{run_id}",
        "status_code": "BLOCKED",
        "status_message": "Cannot proceed. Build tool unavailable.",
        "error_code": "E501",
        "error_reason": "TOOL_UNAVAILABLE: go build command not found in PATH"
      }
    },
    {
      "match": { "tool": "dispatch", "agent": "implementation-tdd", "invocation": 2 },
      "response": {
        "agent_instance_id": "implementation-tdd#11",
        "run_id": "{run_id}",
        "status_code": "SUCCESS",
        "status_message": "Implemented verbose flag parsing and wired to diagnostics."
      }
    }
  ]
}
