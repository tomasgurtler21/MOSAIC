{
  "schema_version": 1,
  "test_id": "phase-end-trigger",
  "on_unmatched": "halt",
  "stubs": [
    {
      "match": { "tool": "dispatch", "agent": "requirements-review", "invocation": 1 },
      "response": {
        "agent_instance_id": "requirements-review#3",
        "run_id": "{run_id}",
        "status_code": "SUCCESS",
        "status_message": "Requirements review passed. No findings."
      },
      "side_effects": {
        "create_files": [
          {
            "path": "Orchestration-{run_id}/requirements-review.md",
            "content": "---\nrun_id: {run_id}\ncreated_by: requirements-review#3\nhuman_approved: false\n---\n# Requirements Review\n\nNo findings.\n"
          }
        ]
      }
    },
    {
      "match": { "tool": "dispatch", "agent": "infra-phase-end", "invocation": 1 },
      "response": {
        "agent_instance_id": "infra-phase-end#4",
        "run_id": "{run_id}",
        "status_code": "SUCCESS",
        "status_message": "Phase-end review complete. No issues observed."
      }
    }
  ]
}
